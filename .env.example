# Copie para .env e preencha. Nunca commite o .env.
NODE_ENV=development
PORT=3000

# Na Vercel use a URL com pooler (Neon/Supabase), ex: ...?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/conectacn?schema=public"

CORS_ORIGIN=http://localhost:4200

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gmail SMTP. SMTP_PASS é uma "senha de app" (Conta Google > Segurança > Senhas de app),
# exige verificação em duas etapas ativada. Em dev, deixe vazio para ver os e-mails no console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ConectaCN <seu-email@gmail.com>"
